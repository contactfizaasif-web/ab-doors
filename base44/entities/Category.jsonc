{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Collection name shown on the site"
    },
    "slug": {
      "type": "string",
      "description": "URL slug, e.g. main-entrance-doors"
    },
    "description": {
      "type": "string",
      "description": "Short description of the collection"
    },
    "image_url": {
      "type": "string",
      "description": "Collection image URL"
    },
    "sort_order": {
      "type": "number",
      "description": "Display order, lowest first",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "description": "Show this collection on the site",
      "default": true
    }
  },
  "required": [
    "name",
    "slug"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}