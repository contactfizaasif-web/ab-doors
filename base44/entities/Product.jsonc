{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Door name"
    },
    "slug": {
      "type": "string",
      "description": "URL slug for the door detail page"
    },
    "sku": {
      "type": "string",
      "description": "Product code shown to customers"
    },
    "category_slug": {
      "type": "string",
      "description": "Slug of the collection this door belongs to"
    },
    "material": {
      "type": "string",
      "description": "Main material, e.g. Solid walnut"
    },
    "finish": {
      "type": "string",
      "description": "Finish or colour, e.g. Matte walnut"
    },
    "availability": {
      "type": "string",
      "description": "In Stock, Made to Order or Unavailable"
    },
    "price": {
      "type": "number",
      "description": "Price in PKR. Leave empty when quoted on request"
    },
    "price_on_request": {
      "type": "boolean",
      "description": "Show Request Pricing instead of a price",
      "default": true
    },
    "image_url": {
      "type": "string",
      "description": "Main door image URL"
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional image URLs"
    },
    "short_description": {
      "type": "string",
      "description": "One-line summary used on cards"
    },
    "description": {
      "type": "string",
      "description": "Full door description"
    },
    "width_mm": {
      "type": "number",
      "description": "Standard width in mm"
    },
    "height_mm": {
      "type": "number",
      "description": "Standard height in mm"
    },
    "thickness_mm": {
      "type": "number",
      "description": "Standard thickness in mm"
    },
    "is_featured": {
      "type": "boolean",
      "description": "Show in the featured doors grid",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "description": "Show this door in the shop",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "description": "Display order, lowest first",
      "default": 0
    }
  },
  "required": [
    "name",
    "slug",
    "category_slug"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}